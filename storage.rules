rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Audio files for transcription (Notes tab)
    // Only authenticated users within the same firm can upload/read
    match /firms/{firmId}/clients/{clientId}/audio/{audioFile} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId) ||
        (request.auth.token.role == 'client' && request.auth.token.firmId == firmId && request.auth.token.clientId == clientId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Document uploads (executed copies, scans, etc.)
    match /firms/{firmId}/clients/{clientId}/documents/{docFile} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId) ||
        (request.auth.token.role == 'client' && request.auth.token.firmId == firmId && request.auth.token.clientId == clientId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 100 * 1024 * 1024;
    }

    // Scanned questionnaire images (handwritten intake photos)
    match /firms/{firmId}/clients/{clientId}/scans/{scanFile} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId) ||
        (request.auth.token.role == 'client' && request.auth.token.firmId == firmId && request.auth.token.clientId == clientId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 50 * 1024 * 1024;
    }

    // Draft document uploads from vault (docx/pdf files uploaded by staff for AI processing)
    match /firms/{firmId}/clients/{clientId}/uploads/{uploadFile} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 20 * 1024 * 1024;
    }


    // Firm logos and branding assets
    match /firms/{firmId}/branding/{file} {
      // Anyone can read branding (displayed on client-facing pages)
      allow read: if request.auth != null;
      // Only attorneys/admins can upload
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Knowledge base file uploads (PDFs, Word docs for CLE materials, templates)
    match /firms/{firmId}/knowledgeBase/uploads/{file} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 200 * 1024 * 1024;
    }

    // Template file uploads (docx, pdf for document generation)
    match /firms/{firmId}/templates/{file} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role in ['attorney', 'paralegal'] && request.auth.token.firmId == firmId)
      ) && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
