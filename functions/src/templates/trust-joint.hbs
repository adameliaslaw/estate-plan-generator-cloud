<table style="width:100%; margin-top:24pt;">
  <tr>
    <td style="width:50%; padding-right:12pt;">
      <p>_______________________________<br/><strong>{{clientFullName}}</strong>, Settlor and Trustee</p>
    </td>
    <td style="width:50%;">
      <p>_______________________________<br/><strong>{{fullName spouseInfo}}</strong>, Settlor and Trustee</p>
    </td>
  </tr>
</table>

<p style="margin-top:18pt;">Dated: {{fillOrBlank executionDate}}</p>

<h2>ACKNOWLEDGMENT</h2>
<p>[[DRAFT: {{governingState}} notarial acknowledgment for two settlors]]</p>

<h2>SCHEDULE A &mdash; TRUST PROPERTY</h2>
{{#hasItems assets.realEstate}}
<p><strong>Real Property</strong></p>
<ul>
  {{#each assets.realEstate}}{{#if transferToTrust}}
  <li>{{address}}, {{city}}, {{../personalInfo.state}} {{zip}}{{#if blockLot}} &mdash; Block/Lot {{blockLot}}{{/if}}</li>
  {{/if}}{{/each}}
</ul>
{{/hasItems}}
{{#hasItems assets.bankAccounts}}
<p><strong>Bank Accounts</strong></p>
<ul>
  {{#each assets.bankAccounts}}{{#if transferToTrust}}
  <li>{{institution}} &mdash; {{accountType}}{{#if accountNumberLast4}} (ending {{accountNumberLast4}}){{/if}}</li>
  {{/if}}{{/each}}
</ul>
{{/hasItems}}
{{#hasItems assets.investmentAccounts}}
<p><strong>Investment Accounts</strong></p>
<ul>
  {{#each assets.investmentAccounts}}{{#if transferToTrust}}
  <li>{{institution}} &mdash; {{accountType}}{{#if accountNumberLast4}} (ending {{accountNumberLast4}}){{/if}}</li>
  {{/if}}{{/each}}
</ul>
{{/hasItems}}
<p style="font-size:9pt; color:#555;">Retirement accounts are not retitled to the trust. Beneficiary designations are coordinated separately &mdash; see <em>Distribution of Retirement Accounts</em>.</p>

{{!--
  ============================================================================
  SCHEMA ADDITIONS REQUIRED — these bindings have no backing field today.

  governingState : string
      Defaults to 'New Jersey'. Inject in trust-generator.ts; do not hardcode.

  executionDate : string
      Currently no field. Renders as a blank line via fillOrBlank until added.

  trustOptions.survivorsTrust  : boolean
  trustOptions.maritalTrust    : 'none' | 'qtip' | 'outright'
  trustOptions.bypassTrust     : 'none' | 'mandatory' | 'contingent_disclaimer'
      First-death subtrusts. INDEPENDENT, not mutually exclusive — a joint plan
      routinely renders Survivor's + Marital + Disclaimer side by side. Verified
      against a maximal-config Statular package, which carries all three plus a
      QDOT provision as sibling sections under the first-death article.

  trustOptions.familyPotTrust  : boolean
  trustOptions.specialTrustee  : boolean
      specialTrustee also gates the Independent/Interested Trustee definition in
      ADMINISTRATIVE PROVISIONS.

  isNonCitizenSpouse : boolean
      Derived at render time, NOT stored. True when either settlor's
      personalInfo.citizenship / spouseInfo.citizenship is not 'US Citizen'.
      Gates three blocks in two articles: Foreign Trust Savings Provision and
      U.S. Trustee for QDOT under TRUSTEESHIP, and Qualified Domestic Trust
      Provision under FIRST DEATH. Statular renders these whenever the toggle is
      on without consulting citizenship — we suppress instead.

  trustOptions.retirementTreatment : 'conduit' | 'accumulation' | 'per_share'
  trustOptions.substanceAbuseProvisions : boolean
  trustOptions.terminationAge : number        (from trusts[0] at render time)
  trustOptions.distributionStandard : string  (from trusts[0] at render time)

  trustProtector.enabled : boolean
  trustProtector.initial : FiduciaryPerson
      Statular appoints the drafting attorney by default.
  ============================================================================
--}}
