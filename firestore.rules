rules_version = '2';

// ============================================================
// NJ Estate Plan Generator — Firestore Security Rules
// ============================================================
//
// Role-Based Access Control (RBAC) using Firebase Auth custom claims.
//
// Roles (set as custom claims on the Firebase Auth token):
//   admin     — Full access to everything across all firms
//   attorney  — Full read/write to all client data within their firm
//   paralegal — Read all client data within their firm; write only
//               notes, calendar, and documents subcollections
//   client    — Read/write only their own client document and
//               read-only access to their own documents, notes,
//               calendar, and payment records
//
// Collection hierarchy:
//   /firms/{firmId}
//   /firms/{firmId}/clients/{clientId}
//   /firms/{firmId}/clients/{clientId}/documents/{docId}
//   /firms/{firmId}/clients/{clientId}/notes/{noteId}
//   /firms/{firmId}/clients/{clientId}/payments/{paymentId}
//   /firms/{firmId}/clients/{clientId}/calendar/{eventId}
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS
    // ==========================================================

    // Verify the request is coming from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check whether the authenticated user holds a specific role.
    // Roles are stored as custom claims on the Firebase Auth token.
    // e.g. { role: "attorney", firmId: "firm_abc123" }
    function hasRole(role) {
      return isAuthenticated()
          && request.auth.token.role == role;
    }

    // Check if user has a specific capability
    function hasCapability(cap) {
      return isAuthenticated()
          && request.auth.token.capabilities != null
          && cap in request.auth.token.capabilities;
    }

    // Shortcut: admin role — full access to everything.
    // Also explicitly grant them all custom capabilities under the hood
    function isAdmin() {
      return hasRole('admin');
    }

    // Role fallbacks + programmatic capabilities
    function canManageFirmSettings() {
      // Firm settings (incl. provider/API keys) are admin/attorney only;
      // paralegals are excluded by policy (finding AS) but can still be granted
      // the capability explicitly. Mirror in usePermissions.ts.
      return isAdmin() || hasRole('attorney') || hasCapability('manage_firm_settings');
    }

    function canManageUsers() {
      // User management (create/delete/modify staff profiles) is limited to
      // admins and attorneys; paralegals are excluded by policy.
      return isAdmin() || hasRole('attorney') || hasCapability('manage_users');
    }

    function canManageClients() {
      return isAdmin() || hasRole('attorney') || hasCapability('manage_clients');
    }

    function canManageDocuments() {
      return isAdmin() || hasRole('attorney') || hasRole('paralegal') || hasCapability('manage_documents');
    }

    function canManageBilling() {
      // Billing is admin/attorney only; paralegals excluded by policy (finding
      // AS), capability grant still available. Mirror in usePermissions.ts.
      return isAdmin() || hasRole('attorney') || hasCapability('manage_billing');
    }

    // Shortcut: client role — scoped to own record only.
    function isClient() {
      return hasRole('client');
    }

    // Verify the authenticated user's firmId claim matches the
    // firmId path segment being accessed. This ensures attorneys
    // and paralegals can only access data belonging to their firm.
    function belongsToFirm(firmId) {
      return isAuthenticated()
          && request.auth.token.firmId == firmId;
    }

    // Verify a client is accessing their own record.
    // Matches either by UID (when clientId IS the UID) or by the
    // linkedUserId field stored on the client document (for cases
    // where client records were created before the user signed up).
    function isOwnClientRecord(clientId) {
      return isAuthenticated()
          && (request.auth.uid == clientId
              || (resource != null
                  && resource.data.linkedUserId == request.auth.uid));
    }

    // Verify a client-role session owns the client record identified by the
    // path. The `clientId` custom claim is set (alongside role/firmId) only by
    // the trusted admin SDK in linkClient, and equals the client document id.
    // Use this for sub-collection docs (documents/notes/payments/calendar),
    // where `resource` is the CHILD doc and therefore carries no linkedUserId —
    // so isOwnClientRecord() can never match and clients would otherwise be
    // denied read of their own records.
    function isLinkedClient(firmId, clientId) {
      return isAuthenticated()
          && request.auth.token.firmId == firmId
          && request.auth.token.clientId == clientId;
    }

    // Identity fields a client/linked session must never change on their own
    // record. linkedUserId is the access key (changing it could re-point the
    // record at another account or lock the owner out); firmId is the tenant
    // boundary. Both are set only by the trusted admin SDK. Mirrors the
    // self-escalation guard on /users/{userId}.
    function clientIdentityUnchanged() {
      return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['linkedUserId', 'firmId']);
    }

    // ==========================================================
    // VALIDATION HELPER FUNCTIONS
    // ==========================================================

    // Validate that personalInfo contains the required name fields.
    // Used when creating or updating a client document.
    function hasValidPersonalInfo() {
      return request.resource.data.personalInfo is map
          && request.resource.data.personalInfo.keys().hasAll(['firstName', 'lastName'])
          && request.resource.data.personalInfo.firstName is string
          && request.resource.data.personalInfo.firstName.size() > 0
          && request.resource.data.personalInfo.lastName is string
          && request.resource.data.personalInfo.lastName.size() > 0;
    }

    // Validate that a document record has a docType and title.
    function hasValidDocumentFields() {
      return request.resource.data.keys().hasAll(['docType', 'title'])
          && request.resource.data.docType is string
          && request.resource.data.docType.size() > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
    }

    // Validate that a payment record has a positive numeric amount.
    function hasValidPaymentAmount() {
      return request.resource.data.keys().hasAll(['amount'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
    }

    // Validate client status against the allowed enum values.
    // Status is optional on the document; only validated when present.
    function hasValidClientStatus() {
      return !('status' in request.resource.data)
          || request.resource.data.status in [
               'prospect',
               'active',
               'pending_review',
               'completed',
               'archived'
             ];
    }

    // Validate document status against the allowed enum values.
    // Must stay in sync with DocStatus in src/types/index.ts — the editor
    // and review flows write these via the client SDK, and the generation
    // pipeline (admin SDK) writes draft/incomplete/needs_review/error.
    function hasValidDocumentStatus() {
      return !('status' in request.resource.data)
          || request.resource.data.status in [
               'draft',
               'review',
               'final',
               'incomplete',
               'needs_review',
               'error'
             ];
    }

    // Validate payment status against the allowed enum values.
    function hasValidPaymentStatus() {
      return !('status' in request.resource.data)
          || request.resource.data.status in [
               'pending',
               'processing',
               'completed',
               'failed',
               'refunded',
               'paid',
               'partial',
               'overdue',
               'voided'
             ];
    }

    // Validate calendar event status against the allowed enum values.
    function hasValidEventStatus() {
      return !('status' in request.resource.data)
          || request.resource.data.status in [
               'scheduled',
               'confirmed',
               'cancelled',
               'completed',
               'rescheduled'
             ];
    }

    // ==========================================================
    // /firms/{firmId}
    // Firm-level documents contain metadata about each law firm.
    // ==========================================================
    match /firms/{firmId} {

      // Admins can read and write firm documents.
      // Attorneys and paralegals who belong to this firm can read
      // the firm document (e.g. to display firm name/branding).
      // Clients and unauthenticated users have no access.
      allow read: if isAdmin()
                  || (canManageFirmSettings() && belongsToFirm(firmId))
                  || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));

      allow create: if canManageFirmSettings() && belongsToFirm(firmId);

      allow update: if canManageFirmSettings() && belongsToFirm(firmId);

      allow delete: if isAdmin();

      // ========================================================
      // /firms/{firmId}/secrets/{docId}
      // Per-firm third-party API keys (OpenAI/Anthropic/Gemini/Perplexity/
      // CourtListener/AssemblyAI/SendGrid/LawPay/Levitate). NEVER client-
      // readable: the firm doc itself is readable by in-firm staff, so secrets
      // cannot live there (audit finding AR). Written/read only by Cloud
      // Functions via the admin SDK; the Settings UI saves keys through the
      // updateFirmApiKeys callable and shows masked presence indicators stored
      // on the firm doc.
      // ========================================================
      match /secrets/{docId} {
        allow read, write: if false; // Cloud Functions (admin SDK) only
      }

      // ========================================================
      // /firms/{firmId}/tasks/{taskId}
      // Firm-level to-dos and action items.
      // ========================================================
      match /tasks/{taskId} {
        // Attorneys and paralegals can read and write tasks in their firm
        allow read, write: if isAdmin()
                           || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
      }

      // ========================================================
      // /firms/{firmId}/users/{userId}
      // Firm personnel and user profiles.
      // ========================================================
      match /users/{userId} {
        // Users can read their own profile. Admins/Attorneys can read all in their firm.
        allow read: if isAdmin()
                    || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId))
                    || request.auth.uid == userId;

        // Staff managers can create/update/delete any profile in their firm.
        allow create, delete: if canManageUsers() && belongsToFirm(firmId);

        // Managers can do full updates; users may update their own profile but cannot
        // change role, customCapabilities, or firmId (prevents self-escalation).
        allow update: if canManageUsers() && belongsToFirm(firmId)
                      || (request.auth.uid == userId
                          && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['role', 'customCapabilities', 'firmId']));
      }
      
      // ========================================================
      // /firms/{firmId}/calendarEvents/{eventId}
      // Firm-wide calendar events
      // ========================================================
      match /calendarEvents/{eventId} {
        // Staff read all firm events. A client may read only events tied to their
        // own client record (the portal queries where('clientId','==',clientId));
        // resource.data.clientId == token.clientId enforces that boundary even if
        // the URL clientId is tampered with.
        allow read: if isAdmin()
                    || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId))
                    || (isClient() && belongsToFirm(firmId) && resource.data.clientId == request.auth.token.clientId);
        allow write: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
      }

      // ========================================================
      // /firms/{firmId}/activities/{activityId}
      // System activity logs for dashboard feed
      // ========================================================
      match /activities/{activityId} {
        allow read: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        allow write: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
      }

      // ========================================================
      // /firms/{firmId}/auditLog/{logId}
      // Immutable compliance audit trail — written only by Cloud Functions
      // (admin SDK). Staff may read for compliance review; no client access.
      // ========================================================
      match /auditLog/{logId} {
        allow read: if isAdmin()
                    || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        allow create: if false; // Cloud Functions (admin SDK) only
        allow update, delete: if false;
      }

      // ========================================================
      // /firms/{firmId}/pendingTranscripts/{transcriptId}
      // Consult transcripts written by an external, Admin-SDK authenticated
      // transcription pipeline — this app never receives, stores, or plays
      // audio. Staff review the queue and file each transcript into a client
      // matter via the fileTranscriptToMatter callable, which is the only
      // mutation path (admin SDK, bypasses these rules). No client-side
      // writes; staff read-only.
      // ========================================================
      match /pendingTranscripts/{transcriptId} {
        allow read: if isAdmin()
                    || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        allow create, update, delete: if false; // Cloud Functions (admin SDK) only
      }

      // ========================================================
      // /firms/{firmId}/emailTemplates/{templateId}
      // Firm-wide email templates
      // ========================================================
      match /emailTemplates/{templateId} {
        allow read: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        allow write: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
      }

      // ========================================================
      // /firms/{firmId}/clients/{clientId}
      // Client profile documents, including personalInfo and
      // questionnaire data for estate planning intake.
      // ========================================================
      match /clients/{clientId} {

        // --- READ ---
        // Admin: always allowed.
        // Attorney/Paralegal: must belong to the same firm.
        // Client (role=client): may only read their own record.
        // Linked session (e.g. anonymous auth from questionnaire link): may read
        //   their own record when linkedUserId matches. linkedUserId is set only
        //   by the trusted admin SDK in registerClientFromLink, so this is safe.
        allow read: if isAdmin()
                    || ((hasRole('attorney') || hasRole('paralegal') || canManageClients()) && belongsToFirm(firmId))
                    || (isClient() && isOwnClientRecord(clientId))
                    || (isAuthenticated() && isOwnClientRecord(clientId));

        // --- CREATE ---
        // Admin: always allowed.
        // Attorney: allowed within their firm; personalInfo + status validated.
        // Paralegal: NOT allowed to create new client records.
        // Client: NOT allowed to create client records directly
        //         (provisioned by the app backend / attorney).
        allow create: if isAdmin()
                      || (canManageClients()
                          && belongsToFirm(firmId)
                          && hasValidPersonalInfo()
                          && hasValidClientStatus());

        // --- UPDATE ---
        // Admin: always allowed.
        // Attorney: allowed within their firm with validation.
        // Paralegal: allowed within their firm with validation
        //            (needed for questionnaire progress, notes, status updates).
        // Client (role=client): may update ONLY their own record (questionnaire data)
        //         with status and personalInfo validation.
        // Linked session (e.g. anonymous auth from questionnaire link): same as
        //   client self-update. linkedUserId is set only by admin SDK.
        allow update: if isAdmin()
                      || (canManageClients()
                          && belongsToFirm(firmId)
                          && hasValidPersonalInfo()
                          && hasValidClientStatus())
                      || ((hasRole('attorney') || hasRole('paralegal'))
                          && belongsToFirm(firmId)
                          && hasValidPersonalInfo()
                          && hasValidClientStatus())
                      || (isClient()
                          && isOwnClientRecord(clientId)
                          && hasValidPersonalInfo()
                          && hasValidClientStatus()
                          && clientIdentityUnchanged())
                      || (isAuthenticated()
                          && isOwnClientRecord(clientId)
                          && hasValidPersonalInfo()
                          && hasValidClientStatus()
                          && clientIdentityUnchanged());

        // --- DELETE ---
        // Only admins and capabilities managers may delete client records 
        allow delete: if isAdmin()
                      || (canManageClients() && belongsToFirm(firmId));

        // ======================================================
        // /firms/{firmId}/clients/{clientId}/documents/{docId}
        // Generated estate planning documents (wills, trusts, POAs).
        // Per spec: documents can be created/edited by attorney or
        // paralegal roles. Clients may read but not write.
        // ======================================================
        match /documents/{docId} {

          // Admin: always.
          // Attorney/Paralegal: within their firm.
          // Client: read-only access to their own documents.
          allow read: if isAdmin()
                      || ((hasRole('attorney') || hasRole('paralegal') || canManageDocuments()) && belongsToFirm(firmId))
                      || (isClient() && isLinkedClient(firmId, clientId));

          // Admin: always.
          // Attorney or Paralegal: within their firm; docType, title,
          // and status fields are validated on every write.
          // Client: no write access to documents.
          allow create: if isAdmin()
                        || (canManageDocuments()
                            && belongsToFirm(firmId)
                            && hasValidDocumentFields()
                            && hasValidDocumentStatus());

          allow update: if isAdmin()
                        || (canManageDocuments()
                            && belongsToFirm(firmId)
                            && hasValidDocumentFields()
                            && hasValidDocumentStatus());

          // Only admins and attorneys may delete documents.
          // Paralegals should update status to 'archived' instead.
          allow delete: if isAdmin()
                        || (canManageDocuments() && belongsToFirm(firmId));
        }

        // ======================================================
        // /firms/{firmId}/clients/{clientId}/notes/{noteId}
        // Internal case notes. Attorneys and paralegals can write;
        // clients may read notes addressed to them.
        // ======================================================
        match /notes/{noteId} {

          // Admin: always.
          // Attorney/Paralegal: within their firm.
          // Client: may read notes on their own record (e.g. visible
          //         case updates shared by the attorney).
          allow read: if isAdmin()
                      || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId))
                      || (isClient() && isLinkedClient(firmId, clientId));

          // Admin: always.
          // Attorney or Paralegal: within their firm.
          // Client: no write access to notes.
          allow create: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));

          allow update: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));

          // Only admins and attorneys may delete notes.
          allow delete: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        }

        // ======================================================
        // /firms/{firmId}/clients/{clientId}/payments/{paymentId}
        // Payment records for legal services rendered.
        // Clients may view their own payment history (read-only).
        // No client writes — payments are recorded by the system
        // or by attorneys/admins only.
        // ======================================================
        match /payments/{paymentId} {

          // Admin: always.
          // Attorney/Paralegal: within their firm (for billing review).
          // Client: read-only access to their own payment records.
          allow read: if isAdmin()
                      || ((hasRole('attorney') || hasRole('paralegal') || canManageBilling()) && belongsToFirm(firmId))
                      || (isClient() && isLinkedClient(firmId, clientId));

          // Admin: always.
          // Attorney: within their firm; amount and status validated.
          // Paralegal: NOT allowed to create or modify payment records.
          // Client: NO write access.
          allow create: if isAdmin()
                        || (canManageBilling()
                            && belongsToFirm(firmId)
                            && hasValidPaymentAmount()
                            && hasValidPaymentStatus());

          allow update: if isAdmin()
                        || (canManageBilling()
                            && belongsToFirm(firmId)
                            && hasValidPaymentAmount()
                            && hasValidPaymentStatus());

          // Only admins may delete payment records (audit trail).
          allow delete: if isAdmin();
        }

        // ======================================================
        // /firms/{firmId}/clients/{clientId}/calendar/{eventId}
        // Scheduled appointments and events for the client.
        // Attorneys and paralegals can create/edit; clients can
        // read their own upcoming appointments.
        // ======================================================
        match /calendar/{eventId} {

          // Admin: always.
          // Attorney/Paralegal: within their firm.
          // Client: read-only access to their own calendar events.
          allow read: if isAdmin()
                      || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId))
                      || (isClient() && isLinkedClient(firmId, clientId));

          // Admin: always.
          // Attorney or Paralegal: within their firm; event status validated.
          // Client: no write access to calendar events.
          allow create: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal'))
                            && belongsToFirm(firmId)
                            && hasValidEventStatus());

          allow update: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal'))
                            && belongsToFirm(firmId)
                            && hasValidEventStatus());

          // Only admins and attorneys may delete calendar events.
          allow delete: if isAdmin()
                        || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
        }

      } // end /clients/{clientId}

    } // end /firms/{firmId}

    // ==========================================================
    // COLLECTION GROUP QUERIES
    // Used for dashboard widgets like "Recent Notes"
    // ==========================================================
    match /{path=**}/notes/{noteId} {
      // Allow read if the user belongs to the firm specified in the document
      // Note: This relies on the document having a 'firmId' field, which we query on
      allow read: if isAdmin() 
                  || ((hasRole('attorney') || hasRole('paralegal')) 
                      && isAuthenticated() 
                      && request.auth.token.firmId == resource.data.firmId);
    }

    // Collection group query for dashboard Payments panel
    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin() 
                  || ((hasRole('attorney') || hasRole('paralegal') || canManageBilling()) 
                      && isAuthenticated() 
                      && request.auth.token.firmId == resource.data.firmId);
    }

    // ==========================================================
    // /firms/{firmId}/knowledgeBase/{resourceId}
    // Legal knowledge base resources (CLE, case law, etc.)
    // ==========================================================
    match /firms/{firmId}/knowledgeBase/{resourceId} {
      allow read: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal')) && belongsToFirm(firmId));
      allow create, update: if isAdmin() || (canManageFirmSettings() && belongsToFirm(firmId));
      allow delete: if isAdmin();
    }

    // ==========================================================
    // /firms/{firmId}/documentTemplates/{templateId}
    // Handlebars document templates
    // ==========================================================
    match /firms/{firmId}/documentTemplates/{templateId} {
      allow read: if isAdmin() || ((hasRole('attorney') || hasRole('paralegal') || canManageDocuments()) && belongsToFirm(firmId));
      allow create, update: if isAdmin() || (canManageDocuments() && belongsToFirm(firmId));
      allow delete: if isAdmin();
    }

    // ==========================================================
    // COLLECTION GROUP QUERY — documents
    // Needed so staff can query all documents across clients in a
    // single firm-scoped call (e.g. dashboard "Awaiting Review" queue).
    // The query itself filters by firmId; this rule enforces that at
    // the security layer by checking the doc's own firmId field.
    // ==========================================================
    match /{path=**}/documents/{docId} {
      allow read: if isAdmin()
                  || (canManageDocuments() && belongsToFirm(resource.data.firmId));
    }

    // ==========================================================
    // /wills_documents/{fileId}
    // Wills ingestion pipeline — one doc per Drive file, keyed by
    // drive_file_id. Written only by Cloud Functions (Admin SDK).
    // Staff may read for precedent search and review queue.
    // ==========================================================
    match /wills_documents/{fileId} {
      allow read: if isAuthenticated()
                  && request.auth.token.role in ['admin', 'attorney', 'paralegal']
                  && request.auth.token.firmId == resource.data.firmId;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // ==========================================================
    // /pipeline_state/{docId}
    // Operational state for the wills ingestion pipeline:
    //   pipeline_state/control         — kill switch + spend tracking
    //   pipeline_state/drive_sync      — Drive change-watch cursor
    //   pipeline_state/backfill_progress — backfill job status
    // Admins may read (for monitoring); all writes via Admin SDK.
    // ==========================================================
    match /pipeline_state/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // ==========================================================
    // /pipeline_audit_log/{logId}
    // Append-only ingestion + query audit log for the wills pipeline.
    // Separate from the firm-level auditLog at firms/{firmId}/auditLog.
    // Admins may read; no client creates — written by Admin SDK only.
    // ==========================================================
    match /pipeline_audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Cloud Functions (Admin SDK) only
      allow update, delete: if false;
    }

    // ==========================================================
    // DEFAULT DENY
    // Any path not explicitly matched above is denied by default.
    // This is Firestore's built-in behaviour, but calling it out
    // here makes the intent explicit.
    //
    // No rule matches → access denied.
    // ==========================================================

  } // end match /databases/{database}/documents
} // end service cloud.firestore
