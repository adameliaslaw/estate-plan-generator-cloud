# ============================================================
# NJ Estate Plan Generator — Environment Variables
# Elias Counsel, LLC
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=estate-plan-generator
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth client ID (frontend — Settings → Integrations Connect buttons
# for Drive/Calendar). Public value, not a secret. Must match the functions-side
# GOOGLE_CLIENT_ID secret below.
VITE_GOOGLE_CLIENT_ID=

# Emulators (set to true for local development)
VITE_USE_EMULATORS=false

# ============================================================
# Cloud Functions Environment Variables
# Set these via: firebase functions:config:set or
# firebase functions:secrets:set for sensitive values
# ============================================================

# OpenAI API Key (document generation + Whisper transcription, the default
# transcription provider, + background tasks on gpt-4o-mini)
# Set via: firebase functions:secrets:set OPENAI_API_KEY
# OPENAI_API_KEY=sk-...

# AssemblyAI API Key (alternate transcription provider; only used when a firm's
# transcriptionProvider is set to 'assemblyai' — default is Whisper/OpenAI).
# Read from firm settings first, then this env var as a fallback.
# Set via: firebase functions:secrets:set ASSEMBLYAI_API_KEY
# ASSEMBLYAI_API_KEY=

# SendGrid API Key (for email notifications)
# Set via: firebase functions:secrets:set SENDGRID_API_KEY
# SENDGRID_API_KEY=SG....

# LawPay / AffiniPay (for payment processing)
# Set via: firebase functions:secrets:set LAWPAY_API_KEY
# LAWPAY_API_KEY=
# LAWPAY_ACCOUNT_ID=

# Google API (for Drive and Calendar sync)
# Set via: firebase functions:secrets:set GOOGLE_CLIENT_SECRET
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================
# Anthropic Claude — LLM for document drafting + wills extraction
# ============================================================

# firebase functions:secrets:set ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Vertex AI — text-embedding-005 for KB vector search
# ============================================================
# Embeddings authenticate via Application Default Credentials (GoogleAuth), NOT
# an API key. There is no VERTEX_AI_KEY to set here. (A vestigial VERTEX_AI_KEY
# secret declaration was removed from the generate* functions — it was read by
# no code. The Secret Manager value itself can be destroyed; see HOMEWORK.md.)

# ============================================================
# Legal Research — CourtListener
# Stored per-firm in Firestore (firms/{firmId}.courtlistenerApiKey)
# NOT a Firebase secret — configured via firm settings UI
# ============================================================

# CourtListener (free NJ + federal case law)
# Register at: https://www.courtlistener.com/sign-in/
# COURTLISTENER_API_KEY=

# Perplexity — web-citation research in the AI widget's Research mode.
# Stored per-firm in Firestore (firms/{firmId}.perplexityApiKey or
# .settings.perplexityApiKey). NOT a Firebase secret / env var.

# Gemini — optional alternate LLM provider in the AI fallback chain.
# Stored per-firm in Firestore (firms/{firmId}.geminiApiKey or
# .settings.geminiApiKey). NOT a Firebase secret / env var.
