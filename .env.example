# ============================================================
# NJ Estate Plan Generator — Environment Variables
# Elias Counsel, LLC
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=estate-plan-generator
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulators (set to true for local development)
VITE_USE_EMULATORS=false

# ============================================================
# Cloud Functions Environment Variables
# Set these via: firebase functions:config:set or
# firebase functions:secrets:set for sensitive values
# ============================================================

# OpenAI API Key (for document generation and transcription)
# Set via: firebase functions:secrets:set OPENAI_API_KEY
# OPENAI_API_KEY=sk-...

# SendGrid API Key (for email notifications)
# Set via: firebase functions:secrets:set SENDGRID_API_KEY
# SENDGRID_API_KEY=SG....

# LawPay / AffiniPay (for payment processing)
# Set via: firebase functions:secrets:set LAWPAY_API_KEY
# LAWPAY_API_KEY=
# LAWPAY_ACCOUNT_ID=

# Google API (for Drive and Calendar sync)
# Set via: firebase functions:secrets:set GOOGLE_CLIENT_SECRET
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================
# RAG Chat — PageIndex + Anthropic Claude
# Set each via: firebase functions:secrets:set <NAME>
# ============================================================

# Anthropic Claude (LLM for RAG chat responses and document drafting)
# firebase functions:secrets:set ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# PageIndex (vectorless reasoning-based RAG)
# firebase functions:secrets:set PAGEINDEX_API_KEY
# PAGEINDEX_API_KEY=pi-...

# ============================================================
# Legal Research — CourtListener + Fastcase
# Both stored per-firm in Firestore (firms/{firmId}.courtlistenerApiKey etc.)
# NOT Firebase secrets — configured via firm settings UI
# ============================================================

# CourtListener (free NJ + federal case law)
# Register at: https://www.courtlistener.com/sign-in/
# COURTLISTENER_API_KEY=

# Fastcase (NJ Bar member access — contact sales@fastcase.com)
# FASTCASE_API_KEY=

# ============================================================
# AI Receptionist — Carmela (Twilio Voice)
# Set each via: firebase functions:secrets:set <NAME>
# ============================================================

# Twilio credentials — required for call handling and signature validation
# Get from: https://console.twilio.com → Account Info
# firebase functions:secrets:set TWILIO_ACCOUNT_SID
# TWILIO_ACCOUNT_SID=AC...

# firebase functions:secrets:set TWILIO_AUTH_TOKEN
# TWILIO_AUTH_TOKEN=...

# Optional: override the base URL used in Twilio webhook action URLs
# Defaults to: https://us-east1-estate-plan-generator.cloudfunctions.net
# firebase functions:secrets:set FUNCTIONS_BASE_URL
# FUNCTIONS_BASE_URL=https://your-custom-domain.com

# ============================================================
# Mercury (Inception Labs diffusion LLM — for extraction/summarization tasks)
# Set via: firebase functions:secrets:set MERCURY_API_KEY
# Docs: https://inceptionlabs.ai
# ============================================================
# MERCURY_API_KEY=
